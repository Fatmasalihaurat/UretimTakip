<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Üretim Takip Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .sidebar {
            min-width: 250px;
            max-width: 250px;
            min-height: 100vh;
            background-color: #212529;
        }

            .sidebar .nav-link {
                color: #adb5bd;
                transition: all 0.2s;
            }

                .sidebar .nav-link:hover {
                    color: #fff;
                    background-color: #343a40;
                }

                .sidebar .nav-link.active {
                    color: #fff;
                    background-color: #0d6efd;
                }

        .topbar {
            background-color: #ffffff;
            border-bottom: 1px solid #dee2e6;
        }

        .badge-pulse {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
            animation: pulse-red 1.8s infinite;
        }
        @@keyframes pulse-red {
            0% {
                transform: translate(-50%, -50%) scale(0.95);
                box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
            }
            70% {
                transform: translate(-50%, -50%) scale(1.15);
                box-shadow: 0 0 0 8px rgba(220, 53, 69, 0);
            }
            100% {
                transform: translate(-50%, -50%) scale(0.95);
                box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
            }
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <div class="sidebar p-3 text-white">
            <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                <span class="fs-4 fw-bold">⚙️ Üretim Takip</span>
            </a>
            <hr>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item mb-2">
                    <a asp-controller="Home" asp-action="Index" class="nav-link">🏠 Ana Sayfa</a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Urun" asp-action="Index" class="nav-link">📦 Ürün Yönetimi</a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Depo" asp-action="Index" class="nav-link">🏢 Depo Yönetimi</a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Stok" asp-action="Index" class="nav-link">📊 Stok Kontrolü</a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Cari" asp-action="Index" class="nav-link">👥 Cari Yönetimi</a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Siparis" asp-action="Index" class="nav-link">🛒 Sipariş Yönetimi</a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Hedef" asp-action="Index" class="nav-link">🎯 Hedefler</a>
                </li>
                <li class="mb-2">
                    <a asp-controller="Bildirim" asp-action="Index" class="nav-link">🔔 Bildirimler</a>
                </li>
            </ul>
        </div>

        <div class="w-100 d-flex flex-column">
            <nav class="navbar topbar p-3 mb-4 justify-content-between">
                <span class="text-muted fw-semibold">Fabrika Yönetim Paneli</span>
                <div class="d-flex align-items-center">
                    <div class="dropdown me-3">
                        <a href="#" class="text-dark text-decoration-none dropdown-toggle position-relative" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            🔔
                            <span id="unreadNotificationCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none;">
                                0
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="notificationDropdown" style="min-width: 300px; max-height: 400px; overflow-y: auto;">
                            <li><h6 class="dropdown-header d-flex justify-content-between align-items-center">
                                Bildirimler 
                                <button class="btn btn-sm btn-link text-decoration-none p-0" onclick="markAllAsRead()">Tümünü Okundu Yap</button>
                            </h6></li>
                            <li><hr class="dropdown-divider"></li>
                            <div id="notificationListDropdown">
                                <li><a class="dropdown-item text-center text-muted" href="#">Yükleniyor...</a></li>
                            </div>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-center fw-bold" href="/Bildirim/Index">Tüm Bildirimleri Gör</a></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <span class="fw-bold text-dark">👤 Fatma Saliha Urat</span>
                    </div>
                </div>
            </nav>

            <div class="container-fluid px-4">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // =========================================================================
        // Canlı SweetAlert Bildirim Sistemi (Live SweetAlert Notification System)
        // =========================================================================
        window.notificationQueue = [];
        window.isShowingNotification = false;

        function getNotifiedIds() {
            try {
                return JSON.parse(sessionStorage.getItem('notifiedBildirimler') || '[]');
            } catch (e) {
                return [];
            }
        }

        function saveNotifiedIds(ids) {
            try {
                sessionStorage.setItem('notifiedBildirimler', JSON.stringify(ids));
            } catch (e) {}
        }

        // Bildirim kuyruğundaki bildirimleri sırayla SweetAlert Toast olarak gösterir
        function processNotificationQueue() {
            if (window.isShowingNotification || window.notificationQueue.length === 0) {
                return;
            }

            window.isShowingNotification = true;
            const item = window.notificationQueue.shift();

            const textToCheck = ((item.baslik || '') + ' ' + (item.mesaj || '')).toLowerCase();
            const isWarning = /uyarı|bütçe|kritik|stok|dikkat|azaldı|tükendi/.test(textToCheck);
            const isSuccess = /tamamlandı|onaylandı|başarılı/.test(textToCheck);
            const icon = isWarning ? 'warning' : (isSuccess ? 'success' : 'info');

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: icon,
                    title: `🔔 ${item.baslik || 'Sistem Bildirimi'}`,
                    text: item.mesaj || '',
                    showConfirmButton: false,
                    showCloseButton: true,
                    timer: 5000,
                    timerProgressBar: true,
                    didOpen: (toast) => {
                        toast.style.cursor = 'pointer';
                        toast.addEventListener('click', (e) => {
                            if (e.target.classList.contains('swal2-close')) return;
                            window.location.href = '/Bildirim/Index';
                        });
                        toast.onmouseenter = Swal.stopTimer;
                        toast.onmouseleave = Swal.resumeTimer;
                    },
                    willClose: () => {
                        window.isShowingNotification = false;
                        setTimeout(processNotificationQueue, 350);
                    }
                });
            } else {
                window.isShowingNotification = false;
            }
        }

        // Canlı bildirimleri denetle (Rozet sayısını günceller ve yeni/okunmamış bildirimleri SweetAlert ile gösterir)
        function checkLiveNotifications(triggerToasts = true) {
            $.get('/Bildirim/BildirimleriListele', function(res) {
                if (res && res.isSuccess && Array.isArray(res.data)) {
                    const unreadItems = res.data.filter(x => !x.okunduMu);
                    const unreadCount = unreadItems.length;

                    // Rozeti (Badge) güncelle
                    const badge = $('#unreadNotificationCount');
                    if (unreadCount > 0) {
                        badge.text(unreadCount > 99 ? '99+' : unreadCount).show().addClass('badge-pulse');
                    } else {
                        badge.hide().removeClass('badge-pulse');
                    }

                    if (triggerToasts) {
                        const notifiedIds = getNotifiedIds();
                        const newUnreadItems = unreadItems.filter(x => !notifiedIds.includes(x.bildirimId));

                        if (newUnreadItems.length > 0) {
                            if (newUnreadItems.length > 3) {
                                // 3'ten fazla birikmiş varsa toplu özet toast göster
                                if (typeof Swal !== 'undefined') {
                                    Swal.fire({
                                        toast: true,
                                        position: 'top-end',
                                        icon: 'warning',
                                        title: `🔔 ${newUnreadItems.length} Yeni Bildirim!`,
                                        text: 'Okunmamış yeni bildirimleriniz var. Görmek için tıklayın.',
                                        showConfirmButton: false,
                                        showCloseButton: true,
                                        timer: 6000,
                                        timerProgressBar: true,
                                        didOpen: (toast) => {
                                            toast.style.cursor = 'pointer';
                                            toast.addEventListener('click', (e) => {
                                                if (e.target.classList.contains('swal2-close')) return;
                                                window.location.href = '/Bildirim/Index';
                                            });
                                        }
                                    });
                                }
                                newUnreadItems.forEach(item => notifiedIds.push(item.bildirimId));
                            } else {
                                // 1-3 adet ise sırayla kuyruğa ekle ve göster
                                newUnreadItems.forEach(item => {
                                    window.notificationQueue.push(item);
                                    notifiedIds.push(item.bildirimId);
                                });
                                processNotificationQueue();
                            }

                            saveNotifiedIds(notifiedIds);
                        }
                    }
                }
            });
        }

        function loadUnreadCount() {
            checkLiveNotifications(false);
        }

        // Bildirim açılır menüsünü (Dropdown) yükle
        function loadNotificationsDropdown() {
            $.get('/Bildirim/BildirimleriListele', function(res) {
                if (res && res.isSuccess && Array.isArray(res.data)) {
                    var html = '';
                    var unreadList = res.data.filter(x => !x.okunduMu).slice(0, 5); // En son 5 okunmamış
                    
                    if (unreadList.length === 0) {
                        html = '<li><div class="dropdown-item text-center text-muted py-3">🎉 Yeni bildirim yok</div></li>';
                    } else {
                        unreadList.forEach(function(item) {
                            var dateStr = new Date(item.olusturulmaTarihi).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
                            var isWarning = /uyarı|bütçe|kritik|stok|dikkat/i.test((item.baslik || '') + ' ' + (item.mesaj || ''));
                            var icon = isWarning ? '⚠️' : '🔔';
                            var safeBaslik = (item.baslik || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                            var safeMesaj = (item.mesaj || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');

                            html += `<li>
                                        <div class="dropdown-item py-2 border-bottom d-flex justify-content-between align-items-center">
                                            <div style="cursor: pointer; flex-grow: 1; min-width: 0;" onclick="viewNotificationDetail('${item.bildirimId}', '${safeBaslik}', '${safeMesaj}', '${dateStr}')">
                                                <div class="d-flex align-items-center">
                                                    <span class="me-2">${icon}</span>
                                                    <div class="fw-bold text-dark text-truncate">${item.baslik}</div>
                                                </div>
                                                <div class="small text-muted text-truncate" style="max-width: 210px;">${item.mesaj}</div>
                                                <small class="text-muted" style="font-size: 0.72rem;">${dateStr}</small>
                                            </div>
                                            <button class="btn btn-sm btn-outline-success ms-2 p-1 px-2 rounded-circle shadow-sm" title="Okundu Olarak İşaretle" onclick="markAsRead('${item.bildirimId}', event)">✓</button>
                                        </div>
                                     </li>`;
                        });
                    }
                    $('#notificationListDropdown').html(html);
                }
            });
        }

        // Bildirime tıklandığında SweetAlert modal ile açar ve okundu yapar
        function viewNotificationDetail(id, title, message, date) {
            const isWarning = /uyarı|bütçe|kritik|stok|dikkat/i.test(title + ' ' + message);
            Swal.fire({
                icon: isWarning ? 'warning' : 'info',
                title: title,
                html: `<div class="text-start mt-2">
                           <p class="mb-2 text-dark fs-6">${message}</p>
                           <small class="text-muted">📅 ${date || ''}</small>
                       </div>`,
                showCancelButton: true,
                confirmButtonText: 'Bildirim Merkezi',
                cancelButtonText: 'Kapat',
                confirmButtonColor: '#0d6efd'
            }).then((result) => {
                markAsRead(id);
                if (result.isConfirmed) {
                    window.location.href = '/Bildirim/Index';
                }
            });
        }

        // Tek bir bildirimi okundu yap
        function markAsRead(id, event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            $.post('/Bildirim/OkunduYap/' + id, function(res) {
                if (res && res.isSuccess) {
                    checkLiveNotifications(false);
                    loadNotificationsDropdown();
                    if (window.showToast) {
                        showToast('success', 'Bildirim okundu olarak işaretlendi', '', 2000);
                    }
                }
            });
        }

        // Tüm bildirimleri okundu yap
        function markAllAsRead() {
            $.post('/Bildirim/TumunuOkunduYap', function(res) {
                if (res && res.isSuccess) {
                    checkLiveNotifications(false);
                    loadNotificationsDropdown();
                    if (window.showToast) {
                        showToast('success', 'Tüm bildirimler okundu olarak işaretlendi', '', 2000);
                    }
                }
            });
        }

        $(document).ready(function() {
            // Sayfa yüklendiğinde bildirimleri denetle ve yeni olanları toast ile göster
            checkLiveNotifications(true);
            
            // Notification dropdown açıldığında listeyi yükle
            $('#notificationDropdown').on('show.bs.dropdown', function () {
                loadNotificationsDropdown();
            });

            // Her 10 saniyede bir yeni bildirimleri kontrol et
            setInterval(function () {
                checkLiveNotifications(true);
            }, 10000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
