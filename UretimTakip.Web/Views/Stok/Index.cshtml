@{
    ViewData["Title"] = "Stok Kontrolü";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-0">📊 Stok Kontrolü</h2>
        <small class="text-muted" id="sayfaAltBaslik">Aktif depo stok durumları ve miktar yönetimi</small>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <!-- Aktif / Arşiv Filtresi -->
        <div class="btn-group shadow-sm" role="group">
            <button type="button" class="btn btn-sm btn-primary active fw-semibold" id="btnAktifStoklar">
                📦 Aktif Stoklar
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary fw-semibold" id="btnArsivStoklar">
                📁 Arşivdekiler
            </button>
        </div>

        <!-- Depo Filtre Dropdown -->
        <select class="form-select form-select-sm shadow-sm" id="ddlDepoFiltre" style="width: auto; min-width: 170px;">
            <option value="">🏢 Tüm Depolar</option>
        </select>

        <!-- Arama Kutusu -->
        <input type="text" id="txtArama" class="form-control form-control-sm shadow-sm" placeholder="🔍 Ürün, Depo veya Stok Kodu..." style="min-width: 220px;">

        <!-- Yeni Stok Butonu -->
        <button class="btn btn-primary btn-sm fw-semibold shadow-sm text-nowrap" id="btnYeniStokModalAc" data-bs-toggle="modal" data-bs-target="#stokEkleModal">
            ➕ Yeni Stok Tanımla
        </button>
    </div>
</div>

<!-- Arşiv Bilgi Kutusu -->
<div id="arsivBilgiKutusu" class="alert alert-secondary border-0 shadow-sm d-flex align-items-center mb-3 py-2 px-3" style="display: none;">
    <span class="fs-4 me-2">📁</span>
    <div class="small">
        <strong>Arşiv Kayıtları:</strong> Bu sayfadaki stok kayıtları geçmiş sipariş, fatura ve irsaliye kayıtlarının bütünlüğü için veritabanında saklanmaktadır. Dilediğinizde <strong>"Geri Yükle"</strong> butonuna basarak tekrar aktif stok havuzuna dahil edebilirsiniz.
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Depo Adı</th>
                        <th>Ürün Adı</th>
                        <th>Stok Kodu</th>
                        <th>Miktar (Adet)</th>
                        <th>Son Güncellenme Tarihi</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="stokTabloGovdesi">
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            ⏳ Stoklar yükleniyor...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Yeni Stok Tanımlama Modalı -->
<div class="modal fade" id="stokEkleModal" tabindex="-1" aria-labelledby="stokEkleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="stokEkleModalLabel">✨ Yeni Stok Tanımla</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form id="stokEkleFormu">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Depo Seçin</label>
                        <select class="form-select" id="ddlDepo" required>
                            <option value="">-- Depo Seçin --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ürün Seçin</label>
                        <select class="form-select" id="ddlUrun" required>
                            <option value="">-- Ürün Seçin --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Stok Kodu</label>
                        <input type="text" class="form-control" id="txtStokKodu" required placeholder="Örn: STK-CLK-01">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Başlangıç Stok Miktarı</label>
                        <input type="number" class="form-control" id="txtMiktar" min="0" required placeholder="Örn: 50">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" id="btnStokEkleKaydet" class="btn btn-primary">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- Stok Güncelleme Modalı (Mevcut Miktar Revizesi İçin) -->
<div class="modal fade" id="stokGuncelleModal" tabindex="-1" aria-labelledby="stokGuncelleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="stokGuncelleModalLabel">🔄 Stok Miktarını Güncelle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form id="stokGuncelleFormu">
                    <!-- Stok ID'sini saklamak için gizli input -->
                    <input type="hidden" id="hdnStokId" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Depo Adı</label>
                        <input type="text" class="form-control bg-light" id="lblDepoAdi" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ürün Adı</label>
                        <input type="text" class="form-control bg-light" id="lblUrunAdi" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mevcut Stok Miktarı</label>
                        <input type="number" class="form-control bg-light" id="txtMevcutMiktar" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">İşlem Türü</label>
                        <div class="d-flex gap-3 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="islemTuru" id="rdEkle" value="ekle" checked>
                                <label class="form-check-label text-success fw-bold" for="rdEkle">➕ Stok Ekle</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="islemTuru" id="rdCikar" value="cikar">
                                <label class="form-check-label text-danger fw-bold" for="rdCikar">➖ Stok Çıkar</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">İşlem Miktarı</label>
                        <input type="number" class="form-control" id="txtIslemMiktari" min="0" required placeholder="Örn: 10">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" id="btnStokKaydet" class="btn btn-primary">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var urlParams = new URLSearchParams(window.location.search);
            var seciliDepoId = urlParams.get('depoId') || '@ViewBag.SeciliDepoId' || '';
            var arsivModu = false;

            // Depolar ve Ürünler dropdown'larını doldur
            depolariveUrunleriGetir();

            // Sayfa yüklendiğinde stok verilerini otomatik getir
            stoklariGetir();

            // Aktif / Arşiv Filtre Butonları
            $('#btnAktifStoklar').click(function () {
                arsivModu = false;
                $(this).removeClass('btn-outline-primary').addClass('btn-primary active');
                $('#btnArsivStoklar').removeClass('btn-secondary active').addClass('btn-outline-secondary');
                $('#sayfaAltBaslik').text('Aktif depo stok durumları ve miktar yönetimi');
                $('#btnYeniStokModalAc').show();
                $('#arsivBilgiKutusu').slideUp(200);
                stoklariGetir();
            });

            $('#btnArsivStoklar').click(function () {
                arsivModu = true;
                $(this).removeClass('btn-outline-secondary').addClass('btn-secondary active');
                $('#btnAktifStoklar').removeClass('btn-primary active').addClass('btn-outline-primary');
                $('#sayfaAltBaslik').text('Arşivlenen stoklar (Veritabanında korunan geçmiş kayıtlar)');
                $('#btnYeniStokModalAc').hide();
                $('#arsivBilgiKutusu').slideDown(200);
                stoklariGetir();
            });

            // Depo filtre seçimi değiştiğinde
            $('#ddlDepoFiltre').change(function () {
                stoklariGetir();
            });

            // Arama kutusu için canlı filtreleme
            $('#txtArama').on('keyup', function () {
                stoklariGetir();
            });

            // 1. Stokları Getirme Fonksiyonu (AJAX GET)
            function stoklariGetir() {
                var filtreDepoId = $('#ddlDepoFiltre').val() || seciliDepoId;
                var aramaKelimesi = $('#txtArama').val().trim();

                $.ajax({
                    url: '/Stok/StoklariListele',
                    type: 'GET',
                    data: { 
                        depoId: filtreDepoId ? filtreDepoId : null, 
                        aramaKelimesi: aramaKelimesi,
                        arsivdekiler: arsivModu
                    },
                    dataType: 'json',
                    success: function (response) {
                        var html = '';
                        if (response.isSuccess && response.data.length > 0) {
                            $.each(response.data, function (index, item) {
                                // Miktar rozeti
                                var miktarBadge = '';
                                if (arsivModu) {
                                    miktarBadge = `<span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary px-2 py-1">
                                                       📁 ${item.miktar} Adet (Arşivde)
                                                   </span>`;
                                } else if (item.miktar > 10) {
                                    miktarBadge = `<span class="badge bg-success bg-opacity-10 text-success border border-success fw-bold px-2 py-1">
                                                       ✅ ${item.miktar} Adet
                                                   </span>`;
                                } else if (item.miktar > 0) {
                                    miktarBadge = `<span class="badge bg-warning bg-opacity-10 text-warning border border-warning fw-bold px-2 py-1">
                                                       ⚠️ ${item.miktar} Adet (Kritik)
                                                   </span>`;
                                } else {
                                    miktarBadge = `<span class="badge bg-danger bg-opacity-10 text-danger border border-danger fw-bold px-2 py-1">
                                                       ⛔ 0 Adet (Tükendi)
                                                   </span>`;
                                }

                                // İşlem butonları
                                var islemButonlari = '';
                                if (!arsivModu) {
                                    var silButonu = '';
                                    if (item.silinebilirMi || item.miktar === 0) {
                                        silButonu = `<button class="btn btn-sm btn-danger py-1" onclick="stokSil('${item.stokId}', '${item.urunAdi}', '${item.depoAdi}')" title="Sıfır miktarlı stoğu arşivle">
                                                        🚫 Sil
                                                     </button>`;
                                    } else {
                                        silButonu = `<button class="btn btn-sm btn-outline-danger py-1" onclick="stokSilEngelli('${item.urunAdi}', '${item.depoAdi}', ${item.miktar})" title="Stoğu bulunan kayıt silinemez!">
                                                        🚫 Sil
                                                     </button>`;
                                    }

                                    islemButonlari = `
                                        <button class="btn btn-sm btn-outline-primary py-1 me-1" onclick="stokGuncelleModalAc('${item.stokId}', '${item.depoAdi}', '${item.urunAdi}', ${item.miktar})">
                                            🔄 Güncelle
                                        </button>
                                        ${silButonu}
                                    `;
                                } else {
                                    islemButonlari = `
                                        <button class="btn btn-sm btn-success py-1 fw-semibold" onclick="stokGeriYukle('${item.stokId}', '${item.urunAdi}', '${item.depoAdi}')">
                                            ♻️ Geri Yükle
                                        </button>
                                    `;
                                }

                                html += `<tr>
                                            <td class="ps-4 fw-semibold">${item.depoAdi}</td>
                                            <td>${item.urunAdi}</td>
                                            <td><span class="badge bg-light text-dark border">${item.stokKodu || '-'}</span></td>
                                            <td>${miktarBadge}</td>
                                            <td>${item.sonGuncellenmeTarihi || '-'}</td>
                                            <td class="text-end pe-4">
                                                ${islemButonlari}
                                            </td>
                                         </tr>`;
                            });
                        } else {
                            var bosMesaj = arsivModu 
                                ? "📁 Arşivde listelenecek stok kaydı bulunamadı." 
                                : "📂 Aktif listelenecek stok kaydı bulunamadı.";
                            html = `<tr>
                                        <td colspan="6" class="text-center text-muted py-4">${bosMesaj}</td>
                                    </tr>`;
                        }
                        $('#stokTabloGovdesi').html(html);
                    },
                    error: function () {
                        $('#stokTabloGovdesi').html(`<tr><td colspan="6" class="text-center text-danger py-4">❌ Stok verileri yüklenirken hata oluştu!</td></tr>`);
                    }
                });
            }

            // Stoğu sıfır olmayan kaydın silinmeye çalışılması durumunda gösterilen engel uyarısı
            window.stokSilEngelli = function (urunAdi, depoAdi, miktar) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Stoğu Olan Kayıt Silinemez!',
                    html: `<b>"${depoAdi}"</b> deposundaki <b>"${urunAdi}"</b> ürününe ait <b>${miktar}</b> adet stok bulunmaktadır.<br><br>Bir stok kaydını silebilmek (arşivlemek) için depodaki stok miktarının sıfır (0) olması gerekir.<br><br>Lütfen önce <b>Güncelle</b> butonunu kullanarak stoğu sıfırlayın veya sipariş/çıkış işlemlerini tamamlayın.`,
                    confirmButtonText: 'Anladım',
                    confirmButtonColor: '#0d6efd'
                });
            };

            // 2. Ürün ve Depo Dropdown'larını doldurma fonksiyonu (AJAX GET)
            function depolariveUrunleriGetir() {
                // Depoları çek
                $.ajax({
                    url: '/Stok/GetDepolar',
                    type: 'GET',
                    dataType: 'json',
                    success: function (response) {
                        if (response.isSuccess) {
                            var optionsModal = '<option value="">-- Depo Seçin --</option>';
                            var optionsFiltre = '<option value="">🏢 Tüm Depolar</option>';

                            $.each(response.data, function (index, item) {
                                var isSelected = (seciliDepoId && seciliDepoId.toLowerCase() === item.depoId.toLowerCase()) ? 'selected' : '';
                                optionsModal += `<option value="${item.depoId}">${item.depoAdi}</option>`;
                                optionsFiltre += `<option value="${item.depoId}" ${isSelected}>🏢 ${item.depoAdi}</option>`;
                            });

                            $('#ddlDepo').html(optionsModal);
                            $('#ddlDepoFiltre').html(optionsFiltre);
                        }
                    }
                });

                // Ürünleri çek
                $.ajax({
                    url: '/Stok/GetUrunler',
                    type: 'GET',
                    dataType: 'json',
                    success: function (response) {
                        if (response.isSuccess) {
                            var options = '<option value="">-- Ürün Seçin --</option>';
                            $.each(response.data, function (index, item) {
                                options += `<option value="${item.urunId}">${item.urunAdi}</option>`;
                            });
                            $('#ddlUrun').html(options);
                        }
                    }
                });
            }

            // 3. Yeni Stok Tanımlama Kaydı (AJAX POST)
            $('#btnStokEkleKaydet').click(function () {
                var model = {
                    DepoId: $('#ddlDepo').val(),
                    UrunId: $('#ddlUrun').val(),
                    StokKodu: $('#txtStokKodu').val().trim(),
                    Miktar: parseInt($('#txtMiktar').val())
                };

                // Form validation
                if (!model.DepoId || !model.UrunId || !model.StokKodu || isNaN(model.Miktar) || model.Miktar < 0) {
                    showAlert('warning', 'Eksik veya Hatalı Alan', 'Lütfen tüm alanları eksiksiz ve doğru şekilde doldurun!');
                    return;
                }

                $.ajax({
                    url: '/Stok/StokEkle',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(model),
                    success: function (response) {
                        if (response.isSuccess) {
                            $('#stokEkleModal').modal('hide');
                            $('#stokEkleFormu')[0].reset();
                            stoklariGetir();
                            showToast('success', response.message);
                        } else {
                            showAlert('error', 'Hata', response.message);
                        }
                    },
                    error: function () {
                        showAlert('error', 'Hata', 'Sunucuyla iletişim kurulurken hata oluştu!');
                    }
                });
            });

            // 4. Güncelleme Modalı Açma Fonksiyonu
            window.stokGuncelleModalAc = function (stokId, depoAdi, urunAdi, mevcutMiktar) {
                $('#hdnStokId').val(stokId);
                $('#lblDepoAdi').val(depoAdi);
                $('#lblUrunAdi').val(urunAdi);
                $('#txtMevcutMiktar').val(mevcutMiktar);
                $('#txtIslemMiktari').val('');
                $('#rdEkle').prop('checked', true);
                
                $('#stokGuncelleModal').modal('show');
            };

            // 5. Stok Miktarı Güncelleme Kaydetme Fonksiyonu (AJAX POST)
            $('#btnStokKaydet').click(function () {
                var id = $('#hdnStokId').val();
                var mevcutMiktar = parseInt($('#txtMevcutMiktar').val());
                var islemMiktari = parseInt($('#txtIslemMiktari').val());
                var islemTuru = $('input[name="islemTuru"]:checked').val();

                if (isNaN(islemMiktari) || islemMiktari < 0) {
                    showAlert('warning', 'Geçersiz Miktar', 'Lütfen geçerli ve 0 veya daha büyük bir işlem miktarı girin!');
                    return;
                }

                var yeniMiktar = mevcutMiktar;
                if (islemTuru === 'ekle') {
                    yeniMiktar += islemMiktari;
                } else if (islemTuru === 'cikar') {
                    yeniMiktar -= islemMiktari;
                }

                if (yeniMiktar < 0) {
                    showAlert('warning', 'Yetersiz Stok', 'Stok miktarı 0\'dan küçük olamaz! Çıkarılacak miktar, mevcut stoktan fazla olamaz.');
                    return;
                }

                $.ajax({
                    url: '/Stok/StokGuncelle',
                    type: 'POST',
                    data: {
                        id: id,
                        yeniMiktar: yeniMiktar
                    },
                    success: function (response) {
                        if (response.isSuccess) {
                            $('#stokGuncelleModal').modal('hide');
                            stoklariGetir();
                            showToast('success', response.message);
                        } else {
                            showAlert('error', 'Hata', response.message);
                        }
                    },
                    error: function () {
                        showAlert('error', 'Hata', 'Sunucuyla iletişim kurulurken hata oluştu!');
                    }
                });
            });

            // 6. Sıfır Miktarlı Stoğu Arşivleme (Soft-Delete) Fonksiyonu
            window.stokSil = function (stokId, urunAdi, depoAdi) {
                showConfirm({
                    title: 'Stok Kaydını Arşivle (Sil)',
                    text: `"${depoAdi}" deposundaki "${urunAdi}" stok kaydını silmek (arşivlemek) istediğinize emin misiniz?\n\nℹ️ Not: Kayıt veritabanından tamamen silinmeyecek, geçmiş sipariş ve fatura hareketlerinin bütünlüğü için arşivde saklanmaya devam edecektir.`,
                    icon: 'warning',
                    confirmButtonText: 'Evet, Arşivle',
                    cancelButtonText: 'Vazgeç',
                    confirmButtonColor: '#dc3545',
                    onConfirm: function () {
                        $.ajax({
                            url: '/Stok/StokSil',
                            type: 'POST',
                            data: { id: stokId },
                            success: function (response) {
                                if (response.isSuccess) {
                                    stoklariGetir();
                                    showToast('success', response.message);
                                } else {
                                    showAlert('error', 'Hata', response.message);
                                }
                            },
                            error: function () {
                                showAlert('error', 'Hata', 'Silme işlemi sırasında sunucu hatası oluştu!');
                            }
                        });
                    }
                });
            };

            // 7. Arşivdeki Stoğu Yeniden Aktifleştirme (Restore) Fonksiyonu
            window.stokGeriYukle = function (stokId, urunAdi, depoAdi) {
                showConfirm({
                    title: 'Stoğu Geri Yükle',
                    text: `"${depoAdi}" deposundaki "${urunAdi}" stok kaydını arşivden çıkarıp tekrar aktif stoklar listesine dahil etmek istiyor musunuz?`,
                    icon: 'question',
                    confirmButtonText: 'Evet, Aktifleştir',
                    cancelButtonText: 'Vazgeç',
                    confirmButtonColor: '#198754',
                    onConfirm: function () {
                        $.ajax({
                            url: '/Stok/StokGeriYukle',
                            type: 'POST',
                            data: { id: stokId },
                            success: function (response) {
                                if (response.isSuccess) {
                                    stoklariGetir();
                                    showToast('success', response.message);
                                } else {
                                    showAlert('error', 'Hata', response.message);
                                }
                            },
                            error: function () {
                                showAlert('error', 'Hata', 'Geri yükleme işlemi sırasında sunucu hatası oluştu!');
                            }
                        });
                    }
                });
            };
        });
    </script>
}
