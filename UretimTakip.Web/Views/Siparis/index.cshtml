@{
    ViewData["Title"] = "Sipariş Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ÜST BAŞLIK VE KONTROL ÇUBUĞU -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-0">🛒 Sipariş Yönetimi</h2>
        <small class="text-muted" id="sayfaAltBaslik">Alış ve satış siparişleri, termin süreleri ve sevkiyat takibi</small>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <!-- Sipariş Tipi Filtre Butonları -->
        <div class="btn-group shadow-sm" role="group">
            <button type="button" class="btn btn-sm btn-primary active fw-semibold" id="btnFiltreTumu">
                🌐 Tümü
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary fw-semibold" id="btnFiltreSatis">
                🛒 Satış
            </button>
            <button type="button" class="btn btn-sm btn-outline-warning fw-semibold text-dark" id="btnFiltreAlis">
                📦 Alış
            </button>
        </div>

        <!-- Durum Filtre Seçimi -->
        <select id="ddlDurumFiltre" class="form-select form-select-sm shadow-sm" style="width: auto; min-width: 140px;">
            <option value="">📋 Tüm Durumlar</option>
            <option value="Bekliyor">⏳ Bekliyor</option>
            <option value="Tamamlandı">✅ Tamamlandı</option>
            <option value="İptal Edildi">🚫 İptal Edildi</option>
        </select>

        <!-- Canlı Arama Kutusu -->
        <input type="text" id="txtArama" class="form-control form-control-sm shadow-sm" placeholder="🔍 Sipariş No, Cari veya Depo..." style="min-width: 220px;">

        <!-- Yeni Sipariş Butonu -->
        <button class="btn btn-primary btn-sm fw-semibold shadow-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#siparisOlusturModal" onclick="yeniSiparisHazirla()">
            ➕ Yeni Sipariş Oluştur
        </button>
    </div>
</div>

<!-- SİPARİŞ LİSTESİ TABLOSU -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Sipariş No</th>
                        <th>Sipariş Tipi</th>
                        <th>Cari (Müşteri / Tedarikçi)</th>
                        <th>Depo</th>
                        <th>Sipariş Tarihi</th>
                        <th>Vade / Temin Tarihi</th>
                        <th>Toplam Tutar</th>
                        <th>Durum</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="siparisTabloGovdesi">
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            ⏳ Siparişler yükleniyor...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 1. YENİ SİPARİŞ OLUŞTURMA MODALI -->
<div class="modal fade" id="siparisOlusturModal" tabindex="-1" aria-labelledby="siparisOlusturModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="siparisOlusturModalLabel">✨ Yeni Sipariş Oluştur</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <form id="siparisOlusturFormu">
                    <!-- Sipariş Tipi Seçimi (Alış / Satış) -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Sipariş Tipi</label>
                        <div class="d-flex gap-3">
                            <div class="form-check p-3 border rounded-3 flex-fill bg-light" id="boxSatisTuru" style="cursor: pointer;">
                                <input class="form-check-input ms-1 me-2" type="radio" name="rdSiparisTuru" id="rdSatis" value="Satış" checked onchange="siparisTuruDegisti()">
                                <label class="form-check-label fw-bold text-primary" for="rdSatis" style="cursor: pointer;">
                                    🛒 Satış Siparişi <small class="text-muted fw-normal d-block">Müşteriye satış yapılır, depodaki stoktan rezerve edilir / düşülür.</small>
                                </label>
                            </div>
                            <div class="form-check p-3 border rounded-3 flex-fill bg-light" id="boxAlisTuru" style="cursor: pointer;">
                                <input class="form-check-input ms-1 me-2" type="radio" name="rdSiparisTuru" id="rdAlis" value="Alış" onchange="siparisTuruDegisti()">
                                <label class="form-check-label fw-bold text-warning text-dark" for="rdAlis" style="cursor: pointer;">
                                    📦 Alış Siparişi <small class="text-muted fw-normal d-block">Tedarikçiden mal alımı yapılır, tamamlandığında depoya stok girişi yapılır.</small>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Cari Seçimi ve Depo Seçimi -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" id="lblCariSecimBaslik">Müşteri (Cari)</label>
                            <div class="input-group shadow-sm">
                                <input type="hidden" id="hdnCariId" required />
                                <input type="text" id="txtSeciliCariAdi" class="form-control bg-light" placeholder="Lütfen bir cari hesap seçiniz..." readonly required />
                                <button class="btn btn-outline-primary fw-semibold" type="button" onclick="cariSecimModaliniAc()">🔍 Cari Seç</button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" id="lblDepoSecimBaslik">Çıkış Yapılacak Depo</label>
                            <select id="ddlSiparisDepo" class="form-select shadow-sm" required>
                                <option value="">⏳ Depolar yükleniyor...</option>
                            </select>
                        </div>
                    </div>

                    <!-- Tarihler (Sipariş Tarihi ve Vade / Temin Tarihi) -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">📅 Sipariş Tarihi</label>
                            <input type="date" id="txtSiparisTarihi" class="form-control shadow-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" id="lblVadeTarihiBaslik">⏳ Vade / Tahsilat Tarihi</label>
                            <input type="date" id="txtVadeTarihi" class="form-control shadow-sm" />
                            <small class="text-muted" id="txtVadeTarihiAciklama">Müşterinin ödeme vadesi veya teslimat taahhüt tarihi</small>
                        </div>
                    </div>

                    <!-- Sipariş Kalemleri Tablosu -->
                    <div class="d-flex justify-content-between align-items-center mb-2 mt-3">
                        <h5 class="fw-bold text-secondary mb-0">📦 Sipariş Edilen Ürünler</h5>
                        <button type="button" class="btn btn-sm btn-success fw-semibold shadow-sm" onclick="satirEkle()">
                            ➕ Satır Ekle
                        </button>
                    </div>

                    <div class="table-responsive shadow-sm border rounded">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 45%;">Ürün</th>
                                    <th style="width: 15%;">Miktar</th>
                                    <th style="width: 15%;">Birim Fiyat (TL)</th>
                                    <th style="width: 20%;">Toplam (TL)</th>
                                    <th style="width: 5%;" class="text-center">Sil</th>
                                </tr>
                            </thead>
                            <tbody id="detayTabloGovdesi">
                                <!-- Dinamik satırlar buraya eklenecek -->
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-end align-items-center mt-3 pe-2">
                        <h4 class="fw-bold text-dark mb-0">Genel Toplam: <span id="lblGenelToplam" class="text-primary">0,00 TL</span></h4>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary px-4 fw-semibold" onclick="siparisKaydet()">💾 Siparişi Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- 2. SİPARİŞ DÜZENLE MODALI -->
<div class="modal fade" id="siparisDuzenleModal" tabindex="-1" aria-labelledby="siparisDuzenleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold" id="siparisDuzenleModalLabel">✏️ Sipariş Bilgilerini Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <form id="siparisDuzenleFormu">
                    <input type="hidden" id="txtDuzenleSiparisId" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Sipariş Numarası</label>
                        <input type="text" id="lblDuzenleSiparisNo" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Sipariş Tipi</label>
                        <select id="ddlDuzenleSiparisTuru" class="form-select">
                            <option value="Satış">🛒 Satış Siparişi</option>
                            <option value="Alış">📦 Alış Siparişi</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cari Hesap</label>
                        <div class="input-group">
                            <input type="hidden" id="hdnDuzenleCariId" />
                            <input type="text" id="txtDuzenleCariAdi" class="form-control bg-light" readonly />
                            <button class="btn btn-outline-primary" type="button" onclick="duzenleCariSecModalAc()">🔍 Değiştir</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Depo</label>
                        <select id="ddlDuzenleDepo" class="form-select">
                            <!-- Depolar JS ile doldurulacak -->
                        </select>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">📅 Sipariş Tarihi</label>
                            <input type="date" id="txtDuzenleSiparisTarihi" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">⏳ Vade / Temin Tarihi</label>
                            <input type="date" id="txtDuzenleVadeTarihi" class="form-control" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-warning fw-semibold px-4" onclick="siparisDuzenleKaydet()">Güncelle</button>
            </div>
        </div>
    </div>
</div>

<!-- 3. CARİ SEÇİM MODALI -->
<div class="modal fade" id="cariSecModal" tabindex="-1" aria-labelledby="cariSecModalLabel" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title fw-bold" id="cariSecModalLabel">👥 Cari Seçimi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-3">
                <div class="mb-3">
                    <input type="text" id="txtCariAra" class="form-control shadow-sm" placeholder="Cari adı veya koduna göre arama yapın..." oninput="cariAra()" />
                </div>
                <div class="table-responsive" style="max-height: 350px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Cari Kodu</th>
                                <th>Cari Adı / Unvanı</th>
                                <th>Tür</th>
                                <th class="text-center" style="width: 15%;">Seçim</th>
                            </tr>
                        </thead>
                        <tbody id="cariSecimTabloGovdesi">
                            <!-- Cariler JS ile doldurulacak -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 4. ÜRÜN SEÇİM MODALI -->
<div class="modal fade" id="urunSecModal" tabindex="-1" aria-labelledby="urunSecModalLabel" aria-hidden="true" style="z-index: 1065;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title fw-bold" id="urunSecModalLabel">📦 Ürün Seçimi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-3">
                <div class="mb-3">
                    <input type="text" id="txtUrunAra" class="form-control shadow-sm" placeholder="Ürün adı veya koduna göre arama yapın..." oninput="urunAra()" />
                </div>
                <div class="table-responsive" style="max-height: 350px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Ürün Kodu</th>
                                <th>Ürün Adı</th>
                                <th>Fiyat</th>
                                <th class="text-center" style="width: 15%;">Seçim</th>
                            </tr>
                        </thead>
                        <tbody id="urunSecimTabloGovdesi">
                            <!-- Ürünler JS ile doldurulacak -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 5. SİPARİŞ DETAY MODALI -->
<div class="modal fade" id="siparisDetayModal" tabindex="-1" aria-labelledby="siparisDetayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title fw-bold" id="siparisDetayModalLabel">📋 Sipariş Detayları</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row mb-3 pb-3 border-bottom">
                    <div class="col-md-6">
                        <div class="text-muted small">SİPARİŞ NO:</div>
                        <h5 class="fw-bold text-dark" id="detaySiparisNo">-</h5>
                        <div class="text-muted small mt-2">SİPARİŞ TİPİ:</div>
                        <div id="detaySiparisTuruBadge">-</div>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="text-muted small">DURUM:</div>
                        <div id="detayDurumBadge">-</div>
                        <div class="text-muted small mt-2">DEPO:</div>
                        <div class="fw-bold text-dark" id="detayDepoAdi">-</div>
                    </div>
                </div>

                <div class="row mb-3 pb-3 border-bottom">
                    <div class="col-md-6">
                        <div class="text-muted small">CARİ HESAP:</div>
                        <div class="fw-bold text-dark" id="detayCariAdi">-</div>
                        <div class="small text-muted" id="detayCariKodu">-</div>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="text-muted small">SİPARİŞ TARİHİ:</div>
                        <div class="fw-bold text-dark" id="detaySiparisTarihi">-</div>
                        <div class="text-muted small mt-1">VADE / TEMİN TARİHİ:</div>
                        <div class="fw-bold text-primary" id="detayVadeTarihi">-</div>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-2">📦 Sipariş Kalemleri</h6>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ürün Kodu</th>
                                <th>Ürün Adı</th>
                                <th class="text-center">Miktar</th>
                                <th class="text-end">Birim Fiyat</th>
                                <th class="text-end">Satır Toplam</th>
                            </tr>
                        </thead>
                        <tbody id="detayUrunlerTabloGovdesi">
                            <!-- JS ile doldurulacak -->
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <h4 class="fw-bold text-dark mb-0">Toplam: <span id="detayGenelToplam" class="text-primary">0,00 TL</span></h4>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-primary fw-semibold" id="btnDetayFaturaYazdir">🖨️ Fatura Yazdır</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var aktifCariTuruSecimi = 'Satış';
        var aktifSiparisTuruFiltresi = '';
        var aktifDurumFiltresi = '';
        var carilerListesi = [];
        var urunlerListesi = [];
        var depolarListesi = [];
        var seciliSatirElementi = null;
        var cariSecimHedefi = 'ekle'; // 'ekle' veya 'duzenle'

        $(document).ready(function () {
            // İlk açılışta siparişleri ve temel verileri yükle
            siparisleriGetir();
            temelVerileriYukle();

            // Filtre Butonları (Tümü / Satış / Alış)
            $('#btnFiltreTumu').click(function () {
                aktifSiparisTuruFiltresi = '';
                $(this).removeClass('btn-outline-primary').addClass('btn-primary active');
                $('#btnFiltreSatis').removeClass('btn-primary text-white active').addClass('btn-outline-primary');
                $('#btnFiltreAlis').removeClass('btn-warning text-dark active').addClass('btn-outline-warning');
                siparisleriGetir();
            });

            $('#btnFiltreSatis').click(function () {
                aktifSiparisTuruFiltresi = 'Satış';
                $(this).removeClass('btn-outline-primary').addClass('btn-primary text-white active');
                $('#btnFiltreTumu').removeClass('btn-primary active').addClass('btn-outline-primary');
                $('#btnFiltreAlis').removeClass('btn-warning text-dark active').addClass('btn-outline-warning');
                siparisleriGetir();
            });

            $('#btnFiltreAlis').click(function () {
                aktifSiparisTuruFiltresi = 'Alış';
                $(this).removeClass('btn-outline-warning').addClass('btn-warning text-dark active');
                $('#btnFiltreTumu').removeClass('btn-primary active').addClass('btn-outline-primary');
                $('#btnFiltreSatis').removeClass('btn-primary text-white active').addClass('btn-outline-primary');
                siparisleriGetir();
            });

            // Durum Filtresi Değiştiğinde
            $('#ddlDurumFiltre').change(function () {
                aktifDurumFiltresi = $(this).val();
                siparisleriGetir();
            });

            // Canlı Arama
            $('#txtArama').on('keyup', function () {
                siparisleriGetir();
            });
        });

        // 1. SİPARİŞLERİ LİSTELEME
        function siparisleriGetir() {
            var arama = $('#txtArama').val().trim();

            $.ajax({
                url: '/Siparis/SiparisleriListele',
                type: 'GET',
                data: {
                    aramaKelimesi: arama,
                    siparisTuru: aktifSiparisTuruFiltresi,
                    durum: aktifDurumFiltresi
                },
                dataType: 'json',
                success: function (response) {
                    var html = '';
                    if (response.isSuccess && response.data.length > 0) {
                        $.each(response.data, function (index, item) {
                            // Sipariş Tipi Rozeti
                            var turRozet = item.siparisTuru === 'Alış'
                                ? '<span class="badge bg-warning bg-opacity-10 text-dark border border-warning fw-bold px-2 py-1">📦 Alış</span>'
                                : '<span class="badge bg-primary bg-opacity-10 text-primary border border-primary fw-bold px-2 py-1">🛒 Satış</span>';

                            // Durum Rozeti
                            var durumRozet = '';
                            if (item.durum === 'Tamamlandı') {
                                durumRozet = '<span class="badge bg-success bg-opacity-10 text-success border border-success fw-bold px-2 py-1">✅ Tamamlandı</span>';
                            } else if (item.durum === 'İptal Edildi' || item.isDeleted) {
                                durumRozet = '<span class="badge bg-danger bg-opacity-10 text-danger border border-danger fw-bold px-2 py-1">🚫 İptal Edildi</span>';
                            } else {
                                durumRozet = '<span class="badge bg-warning bg-opacity-10 text-dark border border-warning fw-bold px-2 py-1">⏳ Bekliyor</span>';
                            }

                            // İşlem Butonları
                            var islemButonlari = `
                                <button class="btn btn-sm btn-outline-info py-1 me-1" onclick="siparisDetayModaliniAc('${item.siparisId}')" title="Sipariş Detaylarını Görüntüle">
                                    🔍 Detay
                                </button>
                            `;

                            if (item.durum === 'Bekliyor' && !item.isDeleted) {
                                islemButonlari += `
                                    <button class="btn btn-sm btn-outline-success py-1 me-1 fw-semibold" onclick="siparisDurumDegistir('${item.siparisId}', 'Tamamlandı')" title="Siparişi Tamamla">
                                        ✅ Tamamla
                                    </button>
                                    <button class="btn btn-sm btn-warning py-1 me-1 fw-semibold" onclick="siparisDuzenleModalAc('${item.siparisId}')" title="Siparişi Düzenle">
                                        ✏️ Düzenle
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger py-1" onclick="siparisSil('${item.siparisId}')" title="Siparişi İptal Et">
                                        🚫 İptal Et
                                    </button>
                                `;
                            } else if (item.durum === 'Tamamlandı') {
                                islemButonlari += `
                                    <a href="/Siparis/FaturaPdf/${item.siparisId}" target="_blank" class="btn btn-sm btn-outline-secondary py-1 me-1" title="Fatura / İrsaliye Yazdır">
                                        🖨️ Fatura
                                    </a>
                                `;
                            }

                            html += `<tr>
                                        <td class="ps-4"><span class="badge bg-light text-dark border fw-bold">${item.siparisNumarasi}</span></td>
                                        <td>${turRozet}</td>
                                        <td class="fw-semibold">${item.cariAdi} <small class="text-muted d-block">(${item.cariTuru})</small></td>
                                        <td><span class="badge bg-light text-dark border">🏢 ${item.depoAdi}</span></td>
                                        <td>${item.siparisTarihi}</td>
                                        <td><span class="fw-semibold ${item.vadeTarihi !== '-' ? 'text-primary' : 'text-muted'}">${item.vadeTarihi}</span></td>
                                        <td class="fw-bold text-dark">${item.toplamTutar.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' })}</td>
                                        <td>${durumRozet}</td>
                                        <td class="text-end pe-4 text-nowrap">${islemButonlari}</td>
                                     </tr>`;
                        });
                    } else {
                        html = `<tr>
                                    <td colspan="9" class="text-center text-muted py-4">📂 Kriterlere uygun sipariş kaydı bulunamadı.</td>
                                 </tr>`;
                    }
                    $('#siparisTabloGovdesi').html(html);
                },
                error: function () {
                    $('#siparisTabloGovdesi').html(`<tr><td colspan="9" class="text-center text-danger py-4">❌ Siparişler yüklenirken bir hata oluştu!</td></tr>`);
                }
            });
        }

        // 2. TEMEL VERİLERİ (DEPO, CARİ, ÜRÜN) YÜKLEME
        function temelVerileriYukle() {
            // Depoları getir
            $.get('/Stok/GetDepolar', function (res) {
                if (res.isSuccess) {
                    depolarListesi = res.data;
                    var opts = '<option value="">-- Depo Seçin --</option>';
                    $.each(res.data, function (i, d) {
                        opts += `<option value="${d.depoId}">${d.depoAdi}</option>`;
                    });
                    $('#ddlSiparisDepo').html(opts);
                    $('#ddlDuzenleDepo').html(opts);
                }
            });

            // Carileri getir
            $.get('/Cari/CarileriListele', function (res) {
                if (res.isSuccess) {
                    carilerListesi = res.data;
                }
            });

            // Ürünleri getir
            $.get('/Urun/UrunleriListele', function (res) {
                if (res.isSuccess) {
                    urunlerListesi = res.data;
                }
            });
        }

        // 3. YENİ SİPARİŞ MODALINI HAZIRLAMA
        function yeniSiparisHazirla() {
            $('#siparisOlusturFormu')[0].reset();
            $('#hdnCariId').val('');
            $('#txtSeciliCariAdi').val('');
            $('#detayTabloGovdesi').empty();
            $('#lblGenelToplam').text('0,00 TL');
            $('#rdSatis').prop('checked', true);

            // Tarihleri varsayılan olarak doldur
            var bugun = new Date().toISOString().split('T')[0];
            $('#txtSiparisTarihi').val(bugun);

            var vade = new Date();
            vade.setDate(vade.getDate() + 14);
            $('#txtVadeTarihi').val(vade.toISOString().split('T')[0]);

            siparisTuruDegisti();
            satirEkle(); // İlk boş satırı ekle
        }

        // 4. SİPARİŞ TÜRÜ DEĞİŞTİĞİNDE ARAYÜZÜ UYARLAMA
        function siparisTuruDegisti() {
            var seciliTur = $('input[name="rdSiparisTuru"]:checked').val();
            aktifCariTuruSecimi = seciliTur;

            if (seciliTur === 'Satış') {
                $('#lblCariSecimBaslik').text('Müşteri (Cari)');
                $('#lblDepoSecimBaslik').text('Çıkış Yapılacak Depo');
                $('#lblVadeTarihiBaslik').text('⏳ Vade / Tahsilat Tarihi');
                $('#txtVadeTarihiAciklama').text('Müşterinin ödeme vadesi veya teslimat taahhüt tarihi');
                $('#txtSeciliCariAdi').attr('placeholder', 'Lütfen bir müşteri hesabı seçiniz...');
            } else {
                $('#lblCariSecimBaslik').text('Tedarikçi (Cari)');
                $('#lblDepoSecimBaslik').text('Giriş Yapılacak Depo');
                $('#lblVadeTarihiBaslik').text('⏳ Temin / Teslimat Tarihi');
                $('#txtVadeTarihiAciklama').text('Tedarikçinin malzemeyi temin ve teslim edeceği taahhüt tarihi');
                $('#txtSeciliCariAdi').attr('placeholder', 'Lütfen bir tedarikçi hesabı seçiniz...');
            }

            // Cari seçimini sıfırla çünkü tür değişti
            $('#hdnCariId').val('');
            $('#txtSeciliCariAdi').val('');
        }

        // 5. CARİ SEÇİMİ
        function cariSecimModaliniAc() {
            cariSecimHedefi = 'ekle';
            cariModalTablosunuDoldur(carilerListesi);
            $('#cariSecModal').modal('show');
        }

        function duzenleCariSecModalAc() {
            cariSecimHedefi = 'duzenle';
            cariModalTablosunuDoldur(carilerListesi);
            $('#cariSecModal').modal('show');
        }

        function cariModalTablosunuDoldur(liste) {
            var html = '';
            var oncelikliTur = cariSecimHedefi === 'ekle' ? (aktifCariTuruSecimi === 'Satış' ? 'Müşteri' : 'Tedarikçi') : '';

            $.each(liste, function (i, c) {
                var badgeClass = c.cariTuru === 'Müşteri' ? 'bg-info' : 'bg-warning text-dark';
                var highlight = (oncelikliTur && c.cariTuru === oncelikliTur) ? 'table-primary' : '';

                html += `<tr class="${highlight}">
                            <td><span class="badge bg-light text-dark border">${c.cariKodu}</span></td>
                            <td class="fw-semibold">${c.ad}</td>
                            <td><span class="badge ${badgeClass}">${c.cariTuru}</span></td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-primary py-1" onclick="cariSec('${c.id}', '${c.ad}')">Seç</button>
                            </td>
                         </tr>`;
            });
            $('#cariSecimTabloGovdesi').html(html);
        }

        function cariAra() {
            var q = $('#txtCariAra').val().toLowerCase().trim();
            var filtrelenmis = carilerListesi.filter(function (c) {
                return c.ad.toLowerCase().includes(q) || c.cariKodu.toLowerCase().includes(q);
            });
            cariModalTablosunuDoldur(filtrelenmis);
        }

        function cariSec(id, ad) {
            if (cariSecimHedefi === 'duzenle') {
                $('#hdnDuzenleCariId').val(id);
                $('#txtDuzenleCariAdi').val(ad);
            } else {
                $('#hdnCariId').val(id);
                $('#txtSeciliCariAdi').val(ad);
            }
            $('#cariSecModal').modal('hide');
        }

        // 6. DİNAMİK SATIR VE ÜRÜN İŞLEMLERİ
        function satirEkle() {
            var satirHtml = `<tr>
                                <td>
                                    <div class="input-group">
                                        <input type="hidden" class="urun-id-input" required />
                                        <input type="text" class="form-control bg-light urun-adi-input" placeholder="Ürün seçiniz..." readonly required />
                                        <button class="btn btn-outline-primary" type="button" onclick="urunSecimModaliniAc(this)">🔍 Seç</button>
                                    </div>
                                </td>
                                <td>
                                    <input type="number" class="form-control miktar-input" min="1" value="1" oninput="hesapla()" required />
                                </td>
                                <td>
                                    <input type="number" class="form-control fiyat-input" step="0.01" min="0" oninput="hesapla()" required />
                                </td>
                                <td>
                                    <input type="text" class="form-control satir-toplam-input bg-light" value="0,00 TL" readonly />
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="satirSil(this)" title="Satırı Sil">🚫</button>
                                </td>
                             </tr>`;
            $('#detayTabloGovdesi').append(satirHtml);
            hesapla();
        }

        function satirSil(btn) {
            if ($('#detayTabloGovdesi tr').length > 1) {
                $(btn).closest('tr').remove();
                hesapla();
            } else {
                alert('Siparişte en az bir ürün satırı bulunmalıdır!');
            }
        }

        function urunSecimModaliniAc(btn) {
            seciliSatirElementi = $(btn).closest('tr');
            urunModalTablosunuDoldur(urunlerListesi);
            $('#urunSecModal').modal('show');
        }

        function urunModalTablosunuDoldur(liste) {
            var html = '';
            $.each(liste, function (i, u) {
                html += `<tr>
                            <td><span class="badge bg-light text-dark border">${u.urunKodu || u.sistemUrunKodu || '-'}</span></td>
                            <td class="fw-semibold">${u.ad || u.urunAdi}</td>
                            <td class="text-dark">${(u.fiyat || 0).toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' })}</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-primary py-1" onclick="urunSec('${u.id || u.urunId}', '${u.ad || u.urunAdi}', ${u.fiyat || 0})">Seç</button>
                            </td>
                         </tr>`;
            });
            $('#urunSecimTabloGovdesi').html(html);
        }

        function urunAra() {
            var q = $('#txtUrunAra').val().toLowerCase().trim();
            var filtrelenmis = urunlerListesi.filter(function (u) {
                var ad = (u.ad || u.urunAdi || '').toLowerCase();
                var kod = (u.urunKodu || u.sistemUrunKodu || '').toLowerCase();
                return ad.includes(q) || kod.includes(q);
            });
            urunModalTablosunuDoldur(filtrelenmis);
        }

        function urunSec(id, ad, fiyat) {
            if (seciliSatirElementi) {
                seciliSatirElementi.find('.urun-id-input').val(id);
                seciliSatirElementi.find('.urun-adi-input').val(ad);
                seciliSatirElementi.find('.fiyat-input').val(fiyat);
                hesapla();
            }
            $('#urunSecModal').modal('hide');
        }

        function hesapla() {
            var genelToplam = 0;
            $('#detayTabloGovdesi tr').each(function () {
                var miktar = parseFloat($(this).find('.miktar-input').val()) || 0;
                var birimFiyat = parseFloat($(this).find('.fiyat-input').val()) || 0;
                var satirToplam = miktar * birimFiyat;

                $(this).find('.satir-toplam-input').val(satirToplam.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' }));
                genelToplam += satirToplam;
            });
            $('#lblGenelToplam').text(genelToplam.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' }));
        }

        // 7. SİPARİŞİ VERİTABANINA KAYDETME (POST)
        function siparisKaydet() {
            var cariId = $('#hdnCariId').val();
            var depoId = $('#ddlSiparisDepo').val();
            var siparisTuru = $('input[name="rdSiparisTuru"]:checked').val();
            var siparisTarihi = $('#txtSiparisTarihi').val();
            var vadeTarihi = $('#txtVadeTarihi').val() || null;

            if (!cariId) {
                alert('Lütfen bir cari hesap seçin!');
                return;
            }
            if (!depoId) {
                alert('Lütfen bir depo seçin!');
                return;
            }
            if (!siparisTarihi) {
                alert('Lütfen sipariş tarihini girin!');
                return;
            }

            var detaylar = [];
            var hataVar = false;

            $('#detayTabloGovdesi tr').each(function () {
                var urunId = $(this).find('.urun-id-input').val();
                var miktar = parseInt($(this).find('.miktar-input').val());
                var birimFiyat = parseFloat($(this).find('.fiyat-input').val());

                if (!urunId || isNaN(miktar) || miktar <= 0 || isNaN(birimFiyat) || birimFiyat < 0) {
                    hataVar = true;
                    return false;
                }

                detaylar.push({
                    UrunId: urunId,
                    Miktar: miktar,
                    BirimFiyat: birimFiyat
                });
            });

            if (hataVar || detaylar.length === 0) {
                alert('Lütfen tüm satırlardaki ürün, miktar ve fiyat bilgilerini eksiksiz doldurun!');
                return;
            }

            var model = {
                CariId: cariId,
                DepoId: depoId,
                SiparisTuru: siparisTuru,
                SiparisTarihi: siparisTarihi,
                VadeTarihi: vadeTarihi,
                Detaylar: detaylar
            };

            $.ajax({
                url: '/Siparis/SiparisOlustur',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function (res) {
                    if (res.isSuccess) {
                        $('#siparisOlusturModal').modal('hide');
                        siparisleriGetir();
                        alert(res.message);
                    } else {
                        alert('Hata: ' + res.message);
                    }
                },
                error: function () {
                    alert('Sipariş oluşturulurken sunucu hatası meydana geldi!');
                }
            });
        }

        // 8. SİPARİŞ DURUM GÜNCELLEME (TAMAMLA / İPTAL ET)
        function siparisDurumDegistir(id, durum) {
            var mesaj = durum === 'Tamamlandı'
                ? 'Bu siparişi tamamlamak istediğinize emin misiniz? (Alış siparişi ise ürünler depoya kabul edilecek ve stoklara eklenecektir)'
                : 'Bu siparişi iptal etmek istediğinize emin misiniz? (Satış siparişi ise ürünler depodaki stoklara geri yüklenecektir)';

            if (confirm(mesaj)) {
                $.ajax({
                    url: '/Siparis/SiparisDurumGuncelle',
                    type: 'POST',
                    data: { id: id, yeniDurum: durum },
                    success: function (res) {
                        if (res.isSuccess) {
                            siparisleriGetir();
                            alert(res.message);
                        } else {
                            alert('Hata: ' + res.message);
                        }
                    },
                    error: function () {
                        alert('Durum güncellenirken sunucu hatası oluştu!');
                    }
                });
            }
        }

        function siparisSil(id) {
            siparisDurumDegistir(id, 'İptal Edildi');
        }

        // 9. SİPARİŞ DÜZENLEME
        function siparisDuzenleModalAc(id) {
            $.get('/Siparis/SiparisGetir', { id: id }, function (res) {
                if (res.isSuccess && res.data) {
                    var d = res.data;
                    $('#txtDuzenleSiparisId').val(d.siparisId);
                    $('#lblDuzenleSiparisNo').val(d.siparisNumarasi);
                    $('#ddlDuzenleSiparisTuru').val(d.siparisTuru);
                    $('#hdnDuzenleCariId').val(d.cariId);
                    $('#txtDuzenleCariAdi').val(d.cariAdi);
                    $('#ddlDuzenleDepo').val(d.depoId);
                    $('#txtDuzenleSiparisTarihi').val(d.siparisTarihi);
                    $('#txtDuzenleVadeTarihi').val(d.vadeTarihi);

                    $('#siparisDuzenleModal').modal('show');
                } else {
                    alert('Hata: ' + res.message);
                }
            });
        }

        function siparisDuzenleKaydet() {
            var model = {
                SiparisId: $('#txtDuzenleSiparisId').val(),
                SiparisTuru: $('#ddlDuzenleSiparisTuru').val(),
                CariId: $('#hdnDuzenleCariId').val(),
                DepoId: $('#ddlDuzenleDepo').val(),
                SiparisTarihi: $('#txtDuzenleSiparisTarihi').val(),
                VadeTarihi: $('#txtDuzenleVadeTarihi').val() || null
            };

            if (!model.CariId || !model.DepoId || !model.SiparisTarihi) {
                alert('Lütfen tüm zorunlu alanları doldurun!');
                return;
            }

            $.ajax({
                url: '/Siparis/SiparisGuncelle',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function (res) {
                    if (res.isSuccess) {
                        $('#siparisDuzenleModal').modal('hide');
                        siparisleriGetir();
                        alert(res.message);
                    } else {
                        alert('Hata: ' + res.message);
                    }
                },
                error: function () {
                    alert('Güncelleme sırasında sunucu hatası oluştu!');
                }
            });
        }

        // 10. SİPARİŞ DETAY MODALI AÇMA
        function siparisDetayModaliniAc(id) {
            $.get('/Siparis/SiparisDetayGetir', { id: id }, function (res) {
                if (res.isSuccess && res.data) {
                    var s = res.data.siparis;
                    var detaylar = res.data.detaylar;

                    $('#detaySiparisNo').text(s.siparisNumarasi);
                    $('#detayCariAdi').text(s.cariAdi);
                    $('#detayCariKodu').text('Kod: ' + s.cariKodu + ' (' + s.cariTuru + ')');
                    $('#detayDepoAdi').text(s.depoAdi);
                    $('#detaySiparisTarihi').text(s.siparisTarihi);
                    $('#detayVadeTarihi').text(s.vadeTarihi);
                    $('#detayGenelToplam').text(s.toplamTutar.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' }));

                    // Tür rozeti
                    var turBadge = s.siparisTuru === 'Alış'
                        ? '<span class="badge bg-warning bg-opacity-10 text-dark border border-warning fw-bold px-2 py-1">📦 Alış Siparişi</span>'
                        : '<span class="badge bg-primary bg-opacity-10 text-primary border border-primary fw-bold px-2 py-1">🛒 Satış Siparişi</span>';
                    $('#detaySiparisTuruBadge').html(turBadge);

                    // Durum rozeti
                    var durumBadge = '';
                    if (s.durum === 'Tamamlandı') {
                        durumBadge = '<span class="badge bg-success bg-opacity-10 text-success border border-success fw-bold px-2 py-1">✅ Tamamlandı</span>';
                    } else if (s.durum === 'İptal Edildi' || s.isDeleted) {
                        durumBadge = '<span class="badge bg-danger bg-opacity-10 text-danger border border-danger fw-bold px-2 py-1">🚫 İptal Edildi</span>';
                    } else {
                        durumBadge = '<span class="badge bg-warning bg-opacity-10 text-dark border border-warning fw-bold px-2 py-1">⏳ Bekliyor</span>';
                    }
                    $('#detayDurumBadge').html(durumBadge);

                    // Fatura linkini güncelle
                    $('#btnDetayFaturaYazdir').off('click').on('click', function () {
                        window.open('/Siparis/FaturaPdf/' + s.siparisId, '_blank');
                    });

                    // Kalemler tablosunu doldur
                    var html = '';
                    $.each(detaylar, function (i, item) {
                        html += `<tr>
                                    <td><span class="badge bg-light text-dark border">${item.urunKodu}</span></td>
                                    <td class="fw-semibold">${item.urunAdi}</td>
                                    <td class="text-center fw-bold text-primary">${item.miktar} Adet</td>
                                    <td class="text-end">${item.birimFiyat.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' })}</td>
                                    <td class="text-end fw-bold">${item.satirToplam.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' })}</td>
                                 </tr>`;
                    });
                    $('#detayUrunlerTabloGovdesi').html(html);

                    $('#siparisDetayModal').modal('show');
                } else {
                    alert('Hata: ' + res.message);
                }
            });
        }
    </script>
}
