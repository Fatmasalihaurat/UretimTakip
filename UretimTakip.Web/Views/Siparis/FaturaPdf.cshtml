@model UretimTakip.Web.Controllers.FaturaViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Fatura - @Model.SiparisNumarasi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            color: #333;
            padding: 30px;
        }
        .invoice-card {
            max-width: 850px;
            margin: 0 auto;
            border: 1px solid #e0e0e0;
            background: #fff;
            padding: 50px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }
        .invoice-header {
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .company-logo {
            font-size: 26px;
            font-weight: 800;
            color: #2b303a;
            letter-spacing: -0.5px;
        }
        .invoice-title {
            font-size: 36px;
            font-weight: 900;
            color: #0d6efd;
            text-align: right;
            letter-spacing: 1px;
        }
        .info-label {
            color: #8c92ac;
            font-size: 11px;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 3px;
            letter-spacing: 0.5px;
        }
        .info-value {
            font-size: 15px;
            font-weight: 600;
            color: #2d3748;
        }
        .table th {
            font-size: 12px;
            text-transform: uppercase;
            font-weight: 700;
            color: #495057;
            background-color: #f1f3f5;
            border-bottom: 2px solid #dee2e6;
            padding: 12px;
        }
        .table td {
            padding: 15px 12px;
            font-size: 14px;
            border-bottom: 1px solid #dee2e6;
        }
        .grand-total-row {
            background-color: #f8f9fa;
        }
        .badge-invoice {
            font-size: 11px;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 700;
            text-transform: uppercase;
        }

        /* Print Styles */
        @@media print {
            body {
                padding: 0;
                background-color: #fff;
            }
            .invoice-card {
                border: none;
                box-shadow: none;
                padding: 0;
                max-width: 100%;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

<div class="no-print text-center mb-4">
    <button class="btn btn-primary px-4 py-2 fw-semibold shadow-sm" onclick="window.print()">🖨️ Yazdır / PDF Kaydet</button>
</div>

<div class="invoice-card">
    <!-- Header -->
    <div class="invoice-header d-flex justify-content-between align-items-center">
        <div>
            <div class="company-logo">🏬 ÜRETİM TAKİP A.Ş.</div>
            <div class="text-muted small mt-1">
                Eskişehir Organize Sanayi Bölgesi<br>
                Telefon: +90 222 000 00 00<br>
                E-posta: info@uretimtakip.com
            </div>
        </div>
        <div>
            <div class="invoice-title">FATURA</div>
            <div class="text-end text-muted small mt-1">
                Fatura No: <strong class="text-dark">@Model.SiparisNumarasi</strong>
            </div>
        </div>
    </div>

    <!-- Info Section -->
    <div class="row mb-5">
        <div class="col-6">
            <div class="info-label">MÜŞTERİ (CARİ) BİLGİLERİ</div>
            <div class="info-value">@Model.CariAdi</div>
            <div class="text-muted small">Cari Kodu: @Model.CariKodu</div>
            <div class="text-muted small">Müşteri Türü: @Model.CariTuru</div>
        </div>
        <div class="col-6 text-end">
            <div class="info-label">FATURA TARİHİ</div>
            <div class="info-value">@Model.SiparisTarihi.ToString("dd.MM.yyyy HH:mm")</div>
            <div class="info-label mt-3">SİPARİŞ DURUMU</div>
            <div>
                <span class="badge bg-success text-white badge-invoice">@Model.Durum</span>
            </div>
        </div>
    </div>

    <!-- Items Table -->
    <div class="table-responsive mb-4">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th style="width: 15%;">Ürün Kodu</th>
                    <th>Ürün Adı</th>
                    <th class="text-center" style="width: 15%;">Miktar</th>
                    <th class="text-end" style="width: 20%;">Birim Fiyat</th>
                    <th class="text-end" style="width: 25%;">Satır Toplamı</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Detaylar)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border">@item.UrunKodu</span></td>
                        <td class="fw-semibold">@item.UrunAdi</td>
                        <td class="text-center">@item.Miktar</td>
                        <td class="text-end">@item.BirimFiyat.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))</td>
                        <td class="text-end fw-bold text-dark">@item.SatirToplam.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="grand-total-row">
                    <td colspan="3" class="border-0"></td>
                    <td class="text-end fw-bold py-3 fs-6">Genel Toplam:</td>
                    <td class="text-end text-primary fw-bold py-3 fs-5">@Model.ToplamTutar.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Terms / Footer -->
    <div class="mt-5 pt-4 border-top text-center text-muted small">
        <p class="mb-1">Bu fatura sistem tarafından otomatik olarak üretilmiştir.</p>
        <strong>Bizimle çalıştığınız için teşekkür ederiz!</strong>
    </div>
</div>

<script>
    // Sayfa yüklendikten yarım saniye sonra yazdırma ekranını aç
    window.onload = function () {
        setTimeout(function () {
            window.print();
        }, 500);
    }
</script>

</body>
</html>
