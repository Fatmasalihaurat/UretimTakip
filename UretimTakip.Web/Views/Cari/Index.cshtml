@{
}
@{
    ViewData["Title"] = "Cari Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- 1. HEADER BAR -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark">👥 Cari Yönetimi (Müşteri & Tedarikçi)</h2>
    <button class="btn btn-primary fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#cariEkleModal">
        ➕ Yeni Cari Ekle
    </button>
</div>

<!-- 2. TABLE SECTION -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Cari Kodu</th>
                        <th>Cari Adı / Unvanı</th>
                        <th>Cari Türü</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="cariTabloGovdesi">
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            ⏳ Cariler yükleniyor...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 3. MODAL POP-UP FORM -->
<div class="modal fade" id="cariEkleModal" tabindex="-1" aria-labelledby="cariEkleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="cariEkleModalLabel">✨ Yeni Cari Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form id="cariEkleFormu">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cari Kodu</label>
                        <input type="text" class="form-control" id="txtCariKodu" required placeholder="Örn: CARI-001">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cari Adı / Unvanı</label>
                        <input type="text" class="form-control" id="txtCariAd" required placeholder="Örn: Ahmet Yılmaz A.Ş.">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cari Türü</label>
                        <select class="form-select" id="selectCariTuru" required>
                            <option value="">Seçiniz...</option>
                            <option value="Müşteri">Müşteri</option>
                            <option value="Tedarikçi">Tedarikçi</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" id="btnCariKaydet" class="btn btn-primary">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- 4. JAVASCRIPT / JQUERY AJAX LOGIC -->
@section Scripts {
    <script>
        $(document).ready(function () {
            // Sayfa yüklendiğinde carileri otomatik listele
            carileriGetir();

            // 1. CARİLERİ LİSTELEYEN AJAX FONKSİYONU
            function carileriGetir() {
                $.ajax({
                    url: '/Cari/CarileriListele',
                    type: 'GET',
                    dataType: 'json',
                    success: function (response) {
                        var html = '';
                        if (response.isSuccess && response.data.length > 0) {
                            $.each(response.data, function (index, item) {
                                var badgeClass = item.cariTuru === 'Müşteri' ? 'bg-info' : 'bg-warning text-dark';
                                html += `<tr>
                                            <td class="ps-4"><span class="badge bg-light text-dark border">${item.cariKodu}</span></td>
                                            <td class="fw-semibold">${item.ad}</td>
                                            <td><span class="badge ${badgeClass}">${item.cariTuru}</span></td>
                                            <td class="text-end pe-4">
                                                <button class="btn btn-sm btn-danger py-1" onclick="cariSil('${item.id}')">🗑️ Sil</button>
                                            </td>
                                         </tr>`;
                            });
                        } else {
                            html = `<tr>
                                        <td colspan="4" class="text-center text-muted py-4">📂 Listelenecek cari bulunamadı.</td>
                                    </tr>`;
                        }
                        $('#cariTabloGovdesi').html(html);
                    },
                    error: function () {
                        $('#cariTabloGovdesi').html(`<tr><td colspan="4" class="text-center text-danger py-4">❌ Veriler yüklenirken bir hata oluştu!</td></tr>`);
                    }
                });
            }

            // 2. YENİ CARİ EKLEYEN AJAX FONKSİYONU
            $('#btnCariKaydet').click(function () {
                var model = {
                    CariKodu: $('#txtCariKodu').val(),
                    Ad: $('#txtCariAd').val(),
                    CariTuru: $('#selectCariTuru').val()
                };

                if (!model.CariKodu || !model.Ad || !model.CariTuru) {
                    alert('Lütfen tüm alanları doldurun!');
                    return;
                }

                $.ajax({
                    url: '/Cari/CariEkle',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(model),
                    success: function (response) {
                        if (response.isSuccess) {
                            $('#cariEkleModal').modal('hide');
                            $('#cariEkleFormu')[0].reset();
                            carileriGetir(); // Tabloyu tazele
                            alert(response.message);
                        } else {
                            alert('Hata: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Sunucuyla iletişim kurulurken bir hata oluştu!');
                    }
                });
            });
                    // 3. CARİ SİLME AKSİYONU
        window.cariSil = function (id) {
            if (confirm('Bu cari kaydını silmek istediğinize emin misiniz?')) {
                $.ajax({
                    url: '/Cari/CariSil', // İstek atılacak adres
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.isSuccess) {
                            carileriGetir(); // Başarılıysa tabloyu yenile
                            alert(response.message);
                        } else {
                            alert('Hata: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Sunucuyla iletişim kurulurken bir hata oluştu!');
                    }
                });
            }
        };

        });
    </script>
}
 